<section class="trust-strip section-shell">
  <div class="section-heading">
    {% if section.settings.eyebrow != blank %}
      <p class="eyebrow">{{ section.settings.eyebrow }}</p>
    {% endif %}

    {% if section.settings.heading != blank %}
      <h2>{{ section.settings.heading }}</h2>
    {% endif %}

    {% if section.settings.text != blank %}
      <div class="text-muted">{{ section.settings.text }}</div>
    {% endif %}
  </div>

  <div class="trust-strip__grid grid-auto-fit">
    {% for block in section.blocks %}
      <div class="trust-strip__item section-card motion-rise motion-rise-delay-{{ forloop.index }}" {{ block.shopify_attributes }}>
        <p class="trust-strip__value">{{ block.settings.heading }}</p>
        <p class="text-muted">{{ block.settings.text }}</p>
      </div>
    {% endfor %}
  </div>
</section>

{% stylesheet %}
  .trust-strip {
    padding-top: 1rem;
  }

  .trust-strip__item {
    min-height: 100%;
    padding: 1.35rem;
  }

  .trust-strip__value {
    margin-bottom: 0.55rem;
    font-size: 1.05rem;
    font-weight: 800;
    letter-spacing: -0.03em;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Trust strip",
  "max_blocks": 4,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Why shop here"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Designed to convert with a polished, premium feel."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Use these tiles for shipping speed, easy returns, secure checkout, or social proof.</p>"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Fast shipping"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Quick order processing and dependable fulfillment."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trust strip",
      "blocks": [
        {
          "type": "item",
          "settings": {
            "heading": "Fast shipping",
            "text": "Quick order processing and dependable fulfillment."
          }
        },
        {
          "type": "item",
          "settings": {
            "heading": "30-day returns",
            "text": "Give shoppers confidence with a clean return promise."
          }
        },
        {
          "type": "item",
          "settings": {
            "heading": "Secure checkout",
            "text": "Trusted payment methods and friction-free checkout."
          }
        },
        {
          "type": "item",
          "settings": {
            "heading": "Curated quality",
            "text": "A tighter assortment and sharper merchandising story."
          }
        }
      ]
    }
  ]
}
{% endschema %}
