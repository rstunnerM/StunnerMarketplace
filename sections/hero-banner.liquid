<section class="hero-banner full-width">
  <div class="hero-banner__inner section-shell">
    <div class="hero-banner__copy">
      {% if section.settings.eyebrow != blank %}
        <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      {% endif %}

      <h1>{{ section.settings.heading }}</h1>

      {% if section.settings.text != blank %}
        <div class="hero-banner__text text-muted">
          {{ section.settings.text }}
        </div>
      {% endif %}

      <div class="hero-banner__actions">
        {% if section.settings.primary_label != blank and section.settings.primary_link != blank %}
          <a class="button" href="{{ section.settings.primary_link }}">{{ section.settings.primary_label }}</a>
        {% endif %}

        {% if section.settings.secondary_label != blank and section.settings.secondary_link != blank %}
          <a class="button button--secondary" href="{{ section.settings.secondary_link }}">
            {{ section.settings.secondary_label }}
          </a>
        {% endif %}
      </div>

      {% if section.blocks.size > 0 %}
        <div class="hero-banner__highlights">
          {% for block in section.blocks %}
            <div class="hero-banner__highlight section-card" {{ block.shopify_attributes }}>
              <p class="hero-banner__highlight-title">{{ block.settings.title }}</p>
              <p class="text-muted">{{ block.settings.text }}</p>
            </div>
          {% endfor %}
        </div>
      {% endif %}
    </div>

    <div class="hero-banner__media">
      {% if section.settings.image %}
        {{
          section.settings.image
          | image_url: width: 1200
          | image_tag:
            widths: '480, 720, 960, 1200',
            class: 'hero-banner__image',
            alt: section.settings.heading
        }}
      {% else %}
        <div class="hero-banner__placeholder section-card">
          <p class="eyebrow">Theme starter</p>
          <h3>Drop in a campaign image, product photography, or a lifestyle shot.</h3>
          <p class="text-muted">
            This section is ready for your first launch story. Replace the placeholder with your own asset in the theme
            editor.
          </p>
        </div>
      {% endif %}
    </div>
  </div>
</section>

{% stylesheet %}
  .hero-banner {
    background:
      radial-gradient(circle at top right, var(--color-accent-soft), transparent 32%),
      linear-gradient(180deg, var(--color-surface), var(--color-background));
  }

  .hero-banner__inner {
    display: grid;
    grid-template-columns: var(--content-grid);
  }

  .hero-banner__copy,
  .hero-banner__media {
    grid-column: 2;
  }

  .hero-banner__copy {
    display: grid;
    gap: 1.5rem;
    max-width: 42rem;
    padding-right: 2rem;
  }

  .hero-banner__text {
    max-width: 56ch;
    font-size: 1.05rem;
  }

  .hero-banner__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .hero-banner__highlights {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    margin-top: 1rem;
  }

  .hero-banner__highlight {
    padding: 1.25rem;
  }

  .hero-banner__highlight-title {
    margin-bottom: 0.5rem;
    font-weight: 700;
  }

  .hero-banner__media {
    margin-top: 2rem;
  }

  .hero-banner__image,
  .hero-banner__placeholder {
    width: 100%;
    min-height: 28rem;
    border-radius: clamp(1.5rem, 3vw, 2rem);
  }

  .hero-banner__image {
    object-fit: cover;
  }

  .hero-banner__placeholder {
    display: grid;
    align-content: center;
    gap: 1rem;
    padding: clamp(2rem, 5vw, 4rem);
  }

  @media (min-width: 990px) {
    .hero-banner__inner {
      align-items: center;
      grid-template-columns: var(--content-margin) minmax(0, 1fr) minmax(340px, 44rem) var(--content-margin);
      column-gap: 3rem;
    }

    .hero-banner__copy {
      grid-column: 2;
      margin-right: 0;
    }

    .hero-banner__media {
      grid-column: 3;
      margin-top: 0;
    }
  }

  @media (max-width: 989px) {
    .hero-banner__copy {
      padding-right: 0;
    }

    .hero-banner__highlights {
      grid-template-columns: 1fr;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Hero banner",
  "max_blocks": 3,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "New season, sharper storefront"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Build a storefront that feels custom from the first scroll."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Use Shopify's Skeleton theme as a clean base, then shape the homepage around your product story, merchandising priorities, and brand voice.</p>"
    },
    {
      "type": "text",
      "id": "primary_label",
      "label": "Primary button label",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "primary_link",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Secondary button label",
      "default": "Explore collections"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "Secondary button link"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero image"
    }
  ],
  "blocks": [
    {
      "type": "highlight",
      "name": "Highlight",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Premium layout"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Balanced whitespace, clear hierarchy, and flexible content blocks."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero banner",
      "blocks": [
        {
          "type": "highlight",
          "settings": {
            "title": "Premium layout",
            "text": "Balanced whitespace, clear hierarchy, and flexible content blocks."
          }
        },
        {
          "type": "highlight",
          "settings": {
            "title": "Story-led merchandising",
            "text": "Lead with campaigns, collections, and launch narratives instead of placeholders."
          }
        },
        {
          "type": "highlight",
          "settings": {
            "title": "Editor friendly",
            "text": "Everything here is configurable directly inside the Shopify customizer."
          }
        }
      ]
    }
  ]
}
{% endschema %}
