<section class="hero-banner full-width">
  <div class="hero-banner__inner section-shell">
    {% liquid
      assign primary_link = section.settings.primary_link | default: routes.all_products_collection_url
      assign secondary_link = section.settings.secondary_link | default: routes.all_products_collection_url
    %}

    <div class="hero-banner__copy motion-rise">
      {% if section.settings.eyebrow != blank %}
        <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      {% endif %}

      <h1>{{ section.settings.heading }}</h1>

      {% if section.settings.text != blank %}
        <div class="hero-banner__text text-muted">
          {{ section.settings.text }}
        </div>
      {% endif %}

      <div class="hero-banner__actions">
        {% if section.settings.primary_label != blank %}
          <a class="button" href="{{ primary_link }}">{{ section.settings.primary_label }}</a>
        {% endif %}

        {% if section.settings.secondary_label != blank %}
          <a class="button button--secondary" href="{{ secondary_link }}">
            {{ section.settings.secondary_label }}
          </a>
        {% endif %}
      </div>

      {% if section.blocks.size > 0 %}
        <div class="hero-banner__highlights">
          {% for block in section.blocks %}
            <div class="hero-banner__highlight section-card motion-rise motion-rise-delay-{{ forloop.index }}" {{ block.shopify_attributes }}>
              <p class="hero-banner__highlight-title">{{ block.settings.title }}</p>
              <p class="text-muted">{{ block.settings.text }}</p>
            </div>
          {% endfor %}
        </div>
      {% endif %}
    </div>

    <div class="hero-banner__media motion-rise motion-rise-delay-2">
      {% if section.settings.image %}
        {{
          section.settings.image
          | image_url: width: 1200
          | image_tag:
            widths: '480, 720, 960, 1200',
            class: 'hero-banner__image',
            alt: section.settings.heading
        }}
      {% else %}
        <div class="hero-banner__placeholder section-card">
          <p class="eyebrow">Theme starter</p>
          <h3>Drop in a campaign image, product photography, or a lifestyle shot.</h3>
          <p class="text-muted">
            This section is ready for your first launch story. Replace the placeholder with your own asset in the theme
            editor.
          </p>
        </div>
      {% endif %}
    </div>
  </div>
</section>

{% stylesheet %}
  .hero-banner {
    position: relative;
    overflow: clip;
    background:
      radial-gradient(circle at 15% 15%, rgba(255, 255, 255, 0.96), transparent 32%),
      radial-gradient(circle at 85% 12%, rgba(124, 58, 237, 0.18), transparent 28%),
      linear-gradient(180deg, rgba(255, 255, 255, 0.92), rgba(255, 255, 255, 0.3) 40%, transparent 100%);
  }

  .hero-banner::before,
  .hero-banner::after {
    content: '';
    position: absolute;
    border-radius: 999px;
    pointer-events: none;
    filter: blur(40px);
  }

  .hero-banner::before {
    top: 4rem;
    right: -6rem;
    width: 18rem;
    height: 18rem;
    background: rgba(124, 58, 237, 0.14);
  }

  .hero-banner::after {
    bottom: 1rem;
    left: -4rem;
    width: 14rem;
    height: 14rem;
    background: rgba(59, 130, 246, 0.1);
  }

  .hero-banner__inner {
    display: grid;
    grid-template-columns: var(--content-grid);
    position: relative;
    z-index: 1;
  }

  .hero-banner__copy,
  .hero-banner__media {
    grid-column: 2;
  }

  .hero-banner__copy {
    display: grid;
    gap: 1.75rem;
    max-width: 42rem;
    padding-right: 2rem;
  }

  .hero-banner h1 {
    max-width: 11ch;
  }

  .hero-banner__text {
    max-width: 54ch;
    font-size: clamp(1.05rem, 1.4vw, 1.2rem);
  }

  .hero-banner__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    padding-top: 0.25rem;
  }

  .hero-banner__highlights {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.1rem;
    margin-top: 1.25rem;
  }

  .hero-banner__highlight {
    position: relative;
    min-height: 100%;
    padding: 1.35rem;
    transition:
      transform 180ms ease,
      box-shadow 180ms ease,
      border-color 180ms ease;
  }

  .hero-banner__highlight-title {
    margin-bottom: 0.5rem;
    font-size: 1.02rem;
    font-weight: 800;
    letter-spacing: -0.03em;
  }

  .hero-banner__highlight:hover {
    transform: translateY(-4px);
    box-shadow: 0 24px 50px rgba(24, 20, 17, 0.09);
  }

  .hero-banner__media {
    margin-top: 2rem;
  }

  .hero-banner__image,
  .hero-banner__placeholder {
    width: 100%;
    min-height: 34rem;
    border-radius: clamp(1.75rem, 3vw, 2.5rem);
  }

  .hero-banner__image {
    object-fit: cover;
    box-shadow: 0 35px 80px rgba(24, 20, 17, 0.18);
  }

  .hero-banner__placeholder {
    display: grid;
    align-content: center;
    gap: 1rem;
    padding: clamp(2rem, 5vw, 4rem);
    background:
      linear-gradient(135deg, rgba(255, 255, 255, 0.88), rgba(244, 238, 255, 0.74)),
      linear-gradient(180deg, rgba(124, 58, 237, 0.08), transparent);
    box-shadow:
      0 30px 70px rgba(24, 20, 17, 0.12),
      inset 0 1px 0 rgba(255, 255, 255, 0.8);
  }

  @media (min-width: 990px) {
    .hero-banner__inner {
      align-items: center;
      grid-template-columns: var(--content-margin) minmax(0, 1fr) minmax(340px, 44rem) var(--content-margin);
      column-gap: 4rem;
    }

    .hero-banner__copy {
      grid-column: 2;
      margin-right: 0;
    }

    .hero-banner__media {
      grid-column: 3;
      margin-top: 0;
    }
  }

  @media (max-width: 989px) {
    .hero-banner__copy {
      padding-right: 0;
    }

    .hero-banner h1 {
      max-width: 12ch;
    }

    .hero-banner__image,
    .hero-banner__placeholder {
      min-height: 26rem;
    }

    .hero-banner__highlights {
      grid-template-columns: 1fr;
    }
  }

  body.theme-mode-luxury .hero-banner {
    background:
      radial-gradient(circle at 20% 15%, rgba(255, 255, 255, 0.06), transparent 22%),
      radial-gradient(circle at 85% 12%, rgba(212, 168, 93, 0.18), transparent 24%),
      linear-gradient(180deg, rgba(255, 255, 255, 0.02), transparent 42%);
  }

  body.theme-mode-luxury .hero-banner__placeholder {
    background:
      linear-gradient(135deg, rgba(212, 168, 93, 0.08), rgba(255, 255, 255, 0.03)),
      linear-gradient(180deg, rgba(255, 255, 255, 0.02), transparent);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Hero banner",
  "max_blocks": 3,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "New season, sharper storefront"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Build a storefront that feels custom from the first scroll."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Use Shopify's Skeleton theme as a clean base, then shape the homepage around your product story, merchandising priorities, and brand voice.</p>"
    },
    {
      "type": "text",
      "id": "primary_label",
      "label": "Primary button label",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "primary_link",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Secondary button label",
      "default": "Explore collections"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "Secondary button link"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero image"
    }
  ],
  "blocks": [
    {
      "type": "highlight",
      "name": "Highlight",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Premium layout"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Balanced whitespace, clear hierarchy, and flexible content blocks."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero banner",
      "blocks": [
        {
          "type": "highlight",
          "settings": {
            "title": "Premium layout",
            "text": "Balanced whitespace, clear hierarchy, and flexible content blocks."
          }
        },
        {
          "type": "highlight",
          "settings": {
            "title": "Story-led merchandising",
            "text": "Lead with campaigns, collections, and launch narratives instead of placeholders."
          }
        },
        {
          "type": "highlight",
          "settings": {
            "title": "Editor friendly",
            "text": "Everything here is configurable directly inside the Shopify customizer."
          }
        }
      ]
    }
  ]
}
{% endschema %}
