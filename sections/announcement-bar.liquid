{% if section.blocks.size > 0 %}
  <div class="announcement-bar full-width">
    <div class="announcement-bar__inner">
      {% for block in section.blocks %}
        {% if block.settings.text != blank %}
          {% if block.settings.link != blank %}
            <a class="announcement-bar__item" href="{{ block.settings.link }}" {{ block.shopify_attributes }}>
              <span class="announcement-bar__label">{{ block.settings.label }}</span>
              <span>{{ block.settings.text }}</span>
            </a>
          {% else %}
            <div class="announcement-bar__item" {{ block.shopify_attributes }}>
              <span class="announcement-bar__label">{{ block.settings.label }}</span>
              <span>{{ block.settings.text }}</span>
            </div>
          {% endif %}
        {% endif %}
      {% endfor %}
    </div>
  </div>
{% endif %}

{% stylesheet %}
  .announcement-bar {
    padding-top: 0.75rem;
  }

  .announcement-bar__inner {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    flex-wrap: wrap;
    padding-inline: var(--page-margin);
  }

  .announcement-bar__item {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 2.75rem;
    padding: 0.65rem 1rem;
    border: 1px solid var(--color-foreground-border);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.52);
    color: var(--color-foreground);
    font-size: 0.875rem;
    text-decoration: none;
    -webkit-backdrop-filter: blur(16px);
    backdrop-filter: blur(16px);
  }

  .announcement-bar__label {
    color: var(--color-foreground-subtle);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  body.theme-mode-luxury .announcement-bar__item {
    background: rgba(255, 255, 255, 0.06);
  }

  @media (max-width: 749px) {
    .announcement-bar__inner {
      justify-content: flex-start;
      overflow-x: auto;
      flex-wrap: nowrap;
      scrollbar-width: none;
    }

    .announcement-bar__inner::-webkit-scrollbar {
      display: none;
    }

    .announcement-bar__item {
      white-space: nowrap;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Announcement bar",
  "max_blocks": 3,
  "settings": [],
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Just dropped"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Free shipping over $100"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "enabled_on": {
    "groups": ["header"]
  },
  "presets": [
    {
      "name": "Announcement bar",
      "blocks": [
        {
          "type": "message",
          "settings": {
            "label": "Just dropped",
            "text": "Free shipping over $100"
          }
        },
        {
          "type": "message",
          "settings": {
            "label": "Fast delivery",
            "text": "Ships in 1-2 business days"
          }
        },
        {
          "type": "message",
          "settings": {
            "label": "Returns",
            "text": "30-day easy returns"
          }
        }
      ]
    }
  ]
}
{% endschema %}
