<section class="featured-products section-shell">
  {% assign top_link = section.settings.link_url | default: routes.all_products_collection_url %}
  <div class="featured-products__top">
    <div class="section-heading">
      {% if section.settings.eyebrow != blank %}
        <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2>{{ section.settings.heading }}</h2>
      {% endif %}

      {% if section.settings.text != blank %}
        <div class="text-muted">{{ section.settings.text }}</div>
      {% endif %}
    </div>

    {% if section.settings.link_label != blank %}
      <a class="pill-link" href="{{ top_link }}">{{ section.settings.link_label }}</a>
    {% endif %}
  </div>

  <div class="featured-products__grid">
    {% for block in section.blocks %}
      {% assign featured_product = block.settings.product %}
      <article class="featured-products__card section-card motion-rise motion-rise-delay-{{ forloop.index }}" {{ block.shopify_attributes }}>
        <a
          class="featured-products__media"
          {% if featured_product != blank %}
            href="{{ featured_product.url }}"
          {% else %}
            href="{{ routes.all_products_collection_url }}"
          {% endif %}
        >
          {% if featured_product.featured_image %}
            {% render 'image',
              class: 'featured-products__image',
              image: featured_product.featured_image,
              width: 960,
              height: 1080,
              crop: 'center'
            %}
          {% else %}
            <div class="featured-products__placeholder">
              <span>Product image</span>
            </div>
          {% endif %}

          {% if featured_product.compare_at_price > featured_product.price %}
            <span class="featured-products__badge">Sale</span>
          {% endif %}
        </a>

        <div class="featured-products__content">
          {% if featured_product.vendor != blank and section.settings.show_vendor %}
            <p class="eyebrow">{{ featured_product.vendor }}</p>
          {% endif %}

          <h3>
            <a
              {% if featured_product != blank %}
                href="{{ featured_product.url }}"
              {% else %}
                href="{{ routes.all_products_collection_url }}"
              {% endif %}
            >
              {{ featured_product.title | default: block.settings.fallback_title }}
            </a>
          </h3>

          <div class="featured-products__price-row">
            {% if featured_product != blank %}
              <span class="featured-products__price">{{ featured_product.price | money }}</span>
              {% if featured_product.compare_at_price > featured_product.price %}
                <span class="featured-products__compare text-muted">{{ featured_product.compare_at_price | money }}</span>
              {% endif %}
            {% else %}
              <span class="featured-products__price">$120.00</span>
            {% endif %}
          </div>

          <p class="text-muted">
            {{
              featured_product.description
              | default: block.settings.fallback_text
              | strip_html
              | truncatewords: 18
            }}
          </p>

          <a
            class="button button--secondary featured-products__cta"
            {% if featured_product != blank %}
              href="{{ featured_product.url }}"
            {% else %}
              href="{{ routes.all_products_collection_url }}"
            {% endif %}
          >
            View product
          </a>
        </div>
      </article>
    {% endfor %}
  </div>
</section>

{% stylesheet %}
  .featured-products__top {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 1.5rem;
    margin-bottom: 2rem;
  }

  .featured-products__grid {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .featured-products__card {
    overflow: hidden;
  }

  .featured-products__media {
    position: relative;
    display: block;
    overflow: hidden;
    aspect-ratio: 0.88;
  }

  .featured-products__image,
  .featured-products__image img,
  .featured-products__placeholder {
    width: 100%;
    height: 100%;
  }

  .featured-products__image img {
    object-fit: cover;
    transition: transform 350ms ease;
  }

  .featured-products__placeholder {
    display: grid;
    place-items: center;
    background: linear-gradient(135deg, rgba(124, 58, 237, 0.14), rgba(255, 255, 255, 0.35));
    color: var(--color-foreground-subtle);
  }

  .featured-products__badge {
    position: absolute;
    top: 1rem;
    left: 1rem;
    display: inline-flex;
    padding: 0.45rem 0.75rem;
    border-radius: 999px;
    background: var(--color-accent);
    color: var(--color-accent-contrast);
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .featured-products__content {
    display: grid;
    gap: 0.85rem;
    padding: 1.35rem;
  }

  .featured-products__content .eyebrow {
    margin-bottom: 0;
  }

  .featured-products__content h3 a {
    text-decoration: none;
  }

  .featured-products__price-row {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .featured-products__price {
    font-size: 1.05rem;
    font-weight: 800;
    letter-spacing: -0.03em;
  }

  .featured-products__compare {
    text-decoration: line-through;
  }

  .featured-products__cta {
    width: fit-content;
  }

  .featured-products__card:hover .featured-products__image img {
    transform: scale(1.04);
  }

  @media (max-width: 1099px) {
    .featured-products__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 749px) {
    .featured-products__grid {
      grid-template-columns: 1fr;
    }

    .featured-products__top {
      align-items: start;
      flex-direction: column;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Featured products",
  "max_blocks": 8,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Best sellers"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Products that deserve stronger merchandising."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Feature your hero SKUs, new drops, or highest-margin products with a more modern card layout.</p>"
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show vendor",
      "default": false
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "Shop all products"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Link URL"
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "text",
          "id": "fallback_title",
          "label": "Fallback title",
          "default": "Featured product"
        },
        {
          "type": "text",
          "id": "fallback_text",
          "label": "Fallback text",
          "default": "Add a product block to show a real product card with image, pricing, and a CTA."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Featured products",
      "blocks": [
        {
          "type": "product"
        },
        {
          "type": "product"
        },
        {
          "type": "product"
        },
        {
          "type": "product"
        }
      ]
    }
  ]
}
{% endschema %}
