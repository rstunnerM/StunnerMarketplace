{% style %}
  {% # Loads all font variantions with display: swap %}
  {{ settings.type_primary_font | font_face: font_display: 'swap' }}
  {{ settings.type_primary_font | font_modify: 'weight', 'bold' | font_face: font_display: 'swap' }}
  {{ settings.type_primary_font | font_modify: 'weight', 'bold' | font_modify: 'style', 'italic' | font_face: font_display: 'swap' }}
  {{ settings.type_primary_font | font_modify: 'style', 'italic' | font_face: font_display: 'swap' }}

  {% liquid
    assign background_color = settings.background_color
    assign foreground_color = settings.foreground_color
    assign surface_color = settings.surface_color
    assign accent_color = settings.accent_color
    assign accent_contrast_color = settings.accent_contrast_color

    if settings.theme_mode == 'luxury'
      assign background_color = settings.background_color_luxury
      assign foreground_color = settings.foreground_color_luxury
      assign surface_color = settings.surface_color_luxury
      assign accent_color = settings.accent_color_luxury
      assign accent_contrast_color = settings.accent_contrast_color_luxury
    endif
  %}

  :root {
    --font-primary--family: {{ settings.type_primary_font.family }}, {{ settings.type_primary_font.fallback_families }};
    --font-primary--style: {{ settings.type_primary_font.style }};
    --font-primary--weight: {{ settings.type_primary_font.weight }};
    --page-width: {{ settings.max_page_width }};
    --page-margin: {{ settings.min_page_margin }}px;
    --color-background: {{ background_color }};
    --color-foreground: {{ foreground_color }};
    --color-surface: {{ surface_color }};
    --color-accent: {{ accent_color }};
    --color-accent-contrast: {{ accent_contrast_color }};
    --color-background-soft: {{ background_color | color_modify: 'alpha', 0.88 }};
    --color-foreground-subtle: {{ foreground_color | color_modify: 'alpha', 0.72 }};
    --color-foreground-border-weak: {{ foreground_color | color_modify: 'alpha', 0.08 }};
    --color-foreground-border: {{ foreground_color | color_modify: 'alpha', 0.1 }};
    --color-foreground-border-strong: {{ foreground_color | color_modify: 'alpha', 0.15 }};
    --color-accent-soft: {{ accent_color | color_modify: 'alpha', 0.2 }};
    --style-border-radius-inputs: {{ settings.input_corner_radius }}px;
    --style-border-radius-cards: calc({{ settings.input_corner_radius }}px * 2);
  }
{% endstyle %}
