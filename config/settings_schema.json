[
  {
    "name": "theme_info",
    "theme_name": "Stunner Marketplace",
    "theme_version": "1.0.0",
    "theme_author": "Stunner Labs",
    "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
    "theme_support_url": "https://support.shopify.com/"
  },
  {
    "name": "t:general.typography",
    "settings": [
      {
        "type": "header",
        "content": "t:general.fonts"
      },
      {
        "type": "font_picker",
        "id": "type_primary_font",
        "default": "work_sans_n4",
        "label": "t:general.primary"
      }
    ]
  },
  {
    "name": "t:general.layout",
    "settings": [
      {
        "type": "select",
        "id": "max_page_width",
        "label": "t:labels.page_width",
        "options": [
          {
            "value": "90rem",
            "label": "t:options.page_width.narrow"
          },
          {
            "value": "110rem",
            "label": "t:options.page_width.wide"
          }
        ],
        "default": "110rem"
      },
      {
        "type": "range",
        "id": "min_page_margin",
        "min": 10,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "t:labels.page_margin",
        "default": 24
      }
    ]
  },
  {
    "name": "Brand Colors",
    "settings": [
      {
        "type": "select",
        "id": "theme_mode",
        "label": "Theme mode",
        "options": [
          {
            "value": "light",
            "label": "Light editorial"
          },
          {
            "value": "luxury",
            "label": "Dark luxury"
          }
        ],
        "default": "light"
      },
      {
        "type": "color",
        "id": "background_color",
        "default": "#f7f4ee",
        "label": "t:labels.background"
      },
      {
        "type": "color",
        "id": "foreground_color",
        "default": "#181411",
        "label": "t:labels.foreground"
      },
      {
        "type": "color",
        "id": "surface_color",
        "default": "#fffdf9",
        "label": "Surface"
      },
      {
        "type": "color",
        "id": "accent_color",
        "default": "#7c3aed",
        "label": "Accent"
      },
      {
        "type": "color",
        "id": "accent_contrast_color",
        "default": "#ffffff",
        "label": "Accent contrast"
      },
      {
        "type": "header",
        "content": "Luxury mode colors"
      },
      {
        "type": "color",
        "id": "background_color_luxury",
        "default": "#0b0b11",
        "label": "Luxury background"
      },
      {
        "type": "color",
        "id": "foreground_color_luxury",
        "default": "#f5efe6",
        "label": "Luxury foreground"
      },
      {
        "type": "color",
        "id": "surface_color_luxury",
        "default": "#14141d",
        "label": "Luxury surface"
      },
      {
        "type": "color",
        "id": "accent_color_luxury",
        "default": "#d4a85d",
        "label": "Luxury accent"
      },
      {
        "type": "color",
        "id": "accent_contrast_color_luxury",
        "default": "#111111",
        "label": "Luxury accent contrast"
      },
      {
        "type": "range",
        "id": "input_corner_radius",
        "min": 0,
        "max": 10,
        "step": 1,
        "unit": "px",
        "label": "t:labels.input_corner_radius",
        "default": 4
      }
    ]
  }
]
